			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					}
				},
				"source": [
					"%%pyspark\n",
					"from pyspark.sql.functions import col, sum\n",
					"df = spark.read.load('abfss://synapse-data@adlssaccountak.dfs.core.windows.net/synapse/sales_data.csv', format='csv', header=True, inferSchema=True)\n",
					"\n",
					"# Define the schema (database)\n",
					"spark.sql(\"CREATE DATABASE IF NOT EXISTS salesmart\")\n",
					"\n",
					"# Perform some aggregation (e.g., total sales by year)\n",
					"aggregated_df = df.groupBy(\"YEAR_ID\").agg(\n",
					"    sum(col(\"SALES\")).alias(\"total_sales\")\n",
					")\n",
					"\n",
					"# Write the Delta table without specifying a path\n",
					"aggregated_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"salesmart.SalesAggregation\")\n",
					"\n",
					"print(\"Write in Delta Completed !!!!!\")"
				]
			}
		]
